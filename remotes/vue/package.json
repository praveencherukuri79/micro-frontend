{
  "name": "vue-remote",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5005",
    "build": "vue-tsc --noEmit && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview --port 5005",
    "dev:watch": "concurrently \"npm run build:watch\" \"npm run preview\"",
    "build:webcomponent": "vite build --config vite.config.webcomponent.ts"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "pinia": "^2.1.7"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.3.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "@types/node": "^20.11.30",
    "concurrently": "^8.2.2",
    "typescript": "^5.4.3",
    "vite": "^5.2.8",
    "vue-tsc": "^2.0.7"
  },
  "microfrontend": {
    "type": "vue-vite",
    "port": 5005,
    "exposes": {
      "./App": "./src/vue-remote.ts"
    },
    "webcomponent": {
      "name": "VueWidget",
      "tag": "vue-widget"
    }
  }
}
